# Чтобы git не ругался на разницу переносов строк между Windows и Linux.
# Внутри репозитория всё хранится в одном формате, у тебя на компьютере — в привычном.
* text=auto eol=lf

# Батники Windows обязаны быть с CRLF, иначе cmd.exe их неправильно читает
*.bat text eol=crlf

# Файлы, которые нельзя трогать: это не текст
*.db  binary
*.png binary
*.jpg binary
